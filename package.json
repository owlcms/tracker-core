{
  "name": "@owlcms/tracker-core",
  "version": "1.16.3",
  "description": "Competition hub and WebSocket ingestion core for OWLCMS tracker",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./websocket": "./src/websocket/index.js",
    "./utils": "./src/utils/index.js",
    "./scoring": "./src/scoring/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "echo 'No build step required for @owlcms/tracker-core (ESM source package)'",
    "release": "node scripts/release.js",
    "test": "npm run test:core-smoke && npm run test:championship-storage && npm run test:database-refresh-request && npm run test:broadcast-debounce && npm run test:break-resync && npm run test:athlete-timer-lifecycle && npm run test:record-status-persistence",
    "test:core-smoke": "node tests/smoke-test.js",
    "test:championship-storage": "node tests/championship-storage-test.js",
    "test:database-refresh-request": "node tests/database-refresh-request-test.js",
    "test:broadcast-debounce": "node tests/broadcast-debounce-test.js",
    "test:break-resync": "node tests/break-resync-test.js",
    "test:athlete-timer-lifecycle": "node tests/athlete-timer-lifecycle-test.js",
    "test:record-status-persistence": "node tests/record-status-persistence-test.js"
  },
  "keywords": [
    "owlcms",
    "weightlifting",
    "competition",
    "hub",
    "websocket"
  ],
  "author": "owlcms",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/owlcms/tracker-core.git"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "ws": "^8.18.3"
  }
}
